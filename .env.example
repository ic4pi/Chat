# Paste these into Vercel → Project → Settings → Environment Variables (names must match exactly).
# Every LLM key below can also be pasted per-user in the app (BYOK); the env var is the server default.

# ── LLM providers (lib/providers.js: process.env[<apiKeyEnv>]) ──────────────
VENICE_API_KEY=        # Venice
OPENROUTER_API_KEY=    # OpenRouter (also used by the hub: HUB_WRITER_MODEL / HUB_UTILITY_MODEL)
CEREBRAS_API_KEY=      # Cerebras
GROQ_API_KEY=          # Groq (Llama/Kimi host) — not xAI
XAI_API_KEY=           # xAI (Grok)
NVIDIA_API_KEY=        # NVIDIA NIM (NVIDIA_NIM_API_KEY is also read by the animate pipeline)

# ── Paid-model lock (Venice and any non-free model are locked without this) ──
# Pick a password; enter it once under "Unlock" in the app. ADMIN_PASSWORD also works.
PAID_MODELS_PASSWORD=
SITE_URL=              # https://your-app.vercel.app (sent to OpenRouter as HTTP-Referer)

# ── Optional ────────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=  # web search
HUB_WRITER_MODEL=      # default anthropic/claude-sonnet-4.5 (OpenRouter id)
HUB_UTILITY_MODEL=     # default openai/gpt-4o-mini (OpenRouter id)
