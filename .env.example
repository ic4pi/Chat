# Paste these into Vercel → Project → Settings → Environment Variables (names must match exactly).
# Every LLM key below can also be pasted per-user in the app (BYOK); the env var is the server default.

# ── LLM providers (lib/providers.js: process.env[<apiKeyEnv>]) ──────────────
VENICE_API_KEY=        # Venice
OPENROUTER_API_KEY=    # OpenRouter (also used by the hub: HUB_WRITER_MODEL / HUB_UTILITY_MODEL)
CEREBRAS_API_KEY=      # Cerebras
GROQ_API_KEY=          # Groq (Llama/Kimi host) — not xAI
XAI_API_KEY=           # xAI (Grok) — GROK_API_KEY is also accepted
NVIDIA_API_KEY=        # NVIDIA NIM (NVIDIA_NIM_API_KEY is also read by the animate pipeline)

# ── Paid-model lock (Venice and any non-free model are locked without this) ──
# Unlock password = PAID_MODELS_PASSWORD or ADMIN_PASSWORD (or ADMIN_USERNAME:ADMIN_PASSWORD).
PAID_MODELS_PASSWORD=
SITE_URL=              # https://your-app.vercel.app (sent to OpenRouter as HTTP-Referer)

# ── Optional ────────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=  # web search
HUB_WRITER_MODEL=      # default anthropic/claude-sonnet-4.5 (OpenRouter id)
HUB_UTILITY_MODEL=     # default openai/gpt-4o-mini (OpenRouter id)

# Agency autopilot caps (per UTC day). Pause everything from the admin page.
# AGENCY_MAX_TASK_RUNS_PER_DAY=24
# AGENCY_MAX_POSTS_PER_DAY=12

# ── Agency team tools (all optional; jobs report unconnected ones as MISSING TOOL) ──
# GitHub: fine-grained personal access token with Contents + Pull requests access.
# Lets the dev persona read repo code and open pull requests (you merge = approval).
GITHUB_TOKEN=
# Vercel: account token (read is enough). Deploy status + failure logs for jobs.
VERCEL_TOKEN=
# Stripe: RESTRICTED key, read-only on charges/balance. Real sales in marketing jobs.
STRIPE_SECRET_KEY=
# Google Search Console: one-time setup (service account added to your property).
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
