# Dev-only runner — not part of the Vercel deployment.
sandbox-runner/

# Heavy deps inside the agent UI source tree. The UI itself is pre-built into
# public/agent/; we still upload sandbox-terminal source so a Vercel project
# with Root Directory=sandbox-terminal can build if linked that way.
sandbox-terminal/node_modules/
sandbox-runner/node_modules/

# Modal app sources — deployed with `modal deploy`, not part of the Vercel
# build. Vercel would otherwise try to treat modal/*.py as Python functions.
modal/

# Standalone Python marketing engine — run on its own, not part of the Vercel
# build. Vercel would otherwise try to treat agency-engine/*.py as functions.
agency-engine/
