{
  "version": 2,
  "buildCommand": null,
  "installCommand": "npm install --ignore-scripts",
  "rewrites": [
    { "source": "/",       "destination": "/index.html" },
    { "source": "/admin",  "destination": "/api/admin" },
    { "source": "/agent",  "destination": "/agent/index.html" },
    { "source": "/media",  "destination": "/media/index.html" },
    { "source": "/media/", "destination": "/media/index.html" },

    { "source": "/api/run",                  "destination": "/api/sandbox/run" },
    { "source": "/api/run-code",             "destination": "/api/sandbox/run-code" },
    { "source": "/api/init-repo",            "destination": "/api/sandbox/init-repo" },
    { "source": "/api/init-blank",           "destination": "/api/sandbox/init-blank" },
    { "source": "/api/files",                "destination": "/api/sandbox/files" },
    { "source": "/api/file",                 "destination": "/api/sandbox/file" },
    { "source": "/api/write-files",          "destination": "/api/sandbox/write-files" },
    { "source": "/api/search",               "destination": "/api/sandbox/search" },
    { "source": "/api/detect-test-command",  "destination": "/api/sandbox/detect-test-command" },
    { "source": "/api/git-push",             "destination": "/api/sandbox/git-push" }
  ],
  "functions": {
    "api/chat.js":                 { "maxDuration": 60 },
    "api/sandbox/[op].js":         { "maxDuration": 60 },
    "api/agent-chat.js":           { "maxDuration": 60 },
    "api/group-chat.js":           { "maxDuration": 60 },
    "api/tts.js":                  { "maxDuration": 60 },
    "api/media-generate.js":       { "maxDuration": 60 },
    "api/animate-sequence.js":     { "maxDuration": 60 }
  }
}
